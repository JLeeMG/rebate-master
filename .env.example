# Copy of the settings the rebate master reads. The real values live in .env,
# which scripts/setup_database.ps1 creates. Never commit .env.

DATABASE_URL=postgresql+psycopg://mgrm_app:PASSWORD@localhost:5432/mgrm
TEST_DATABASE_URL=postgresql+psycopg://mgrm_app:PASSWORD@localhost:5432/mgrm_test

# Signs the sign-in cookie. Long and random. Changing it signs everyone out.
SECRET_KEY=

# true once the platform is served over https (i.e. on a server)
SESSION_HTTPS_ONLY=false

# Microsoft 365 sign-in. Leave blank until IT registers the app in Entra ID.
# Redirect URI to give IT: http://localhost:8001/auth/microsoft/callback
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
